# Postgres connection (docker-compose.yml starts one on localhost:5432)
DATABASE_URL="postgresql://gimnafica:gimnafica@localhost:5432/gimnafica"
# Optional: direct (non-pooled) connection for `prisma migrate`, e.g. Neon's
# DATABASE_URL_UNPOOLED. Falls back to DATABASE_URL when not set.
# DATABASE_URL_UNPOOLED=""

# Secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public site URL for OG tags, robots.txt and sitemap. Needed at BUILD time
# (those pages are static). On Vercel it defaults to the production URL, so
# set it only for a custom domain.
# SITE_URL="https://gimnafica.rs"

# First admin account, created by `npx prisma db seed`
ADMIN_EMAIL="admin@gimnafica.rs"
ADMIN_PASSWORD="promeni-me"
ADMIN_NAME="Administrator"
